{
  "name": "haizhizi-decision-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "host": "tsx apps/host/server.ts",
    "build": "tsc --noEmit && vite build --config apps/workspace/vite.config.ts",
    "test": "vitest run",
    "test:e2e": "tsx scripts/check-python.ts --e2e",
    "contracts": "tsx scripts/generate-contracts.ts",
    "live:smoke": "node --use-env-proxy --import tsx scripts/live-smoke.ts",
    "test:python": "tsx scripts/check-python.ts",
    "verify": "npm run contracts && npm test && npm run test:python && npm run test:e2e && npm run build",
    "test:live": ".venv/bin/python scripts/live-check.py",
    "corpus:build": "tsx scripts/corpus.ts build",
    "corpus:collect": "tsx scripts/corpus.ts collect",
    "corpus:import": "tsx scripts/corpus.ts import",
    "corpus:export": "tsx scripts/corpus.ts export",
    "corpus:search": "tsx scripts/corpus.ts search",
    "test:decision:live": "node --use-env-proxy --import tsx scripts/qwen-live-check.ts",
    "documents:evaluate": "node --use-env-proxy --import tsx scripts/evaluate-documents.ts"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "1.0.1",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.1",
    "@deepseek-ai/dsh-deepseek-llm-api-extensions": "0.2.0-rc.1",
    "@deepseek-ai/dsh-http-proxy": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm-deepseek-api-key": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.1",
    "@deepseek-ai/dsh-subagent": "0.2.0-rc.1",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1",
    "@deepseek-ai/dsh-web": "0.2.0-rc.1",
    "@deepseek-ai/dsh-web-fetch-http": "0.2.0-rc.1",
    "@deepseek-ai/dsh-web-search-deepseek": "0.2.0-rc.1",
    "@electric-sql/pglite": "^0.3.14",
    "@mozilla/readability": "0.6.0",
    "@province-city-china/area": "8.5.8",
    "@province-city-china/city": "8.5.8",
    "@province-city-china/province": "8.5.8",
    "@tabler/icons-react": "^3.44.0",
    "@turf/boolean-point-in-polygon": "7.2.0",
    "@turf/boolean-valid": "7.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "linkedom": "0.18.12",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@amap/amap-jsapi-types": "0.0.15",
    "@playwright/test": "^1.58.2",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "json-schema-to-typescript": "^15.0.4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "4.1.11"
  }
}
