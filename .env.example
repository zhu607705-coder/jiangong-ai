# Local development only. Keep secrets on the server.
HOST=127.0.0.1
PORT=4310
CAPABILITY_PORT=4311
WORKSPACE_PORT=5173
# Optional exact LAN origin, behind a reverse proxy with client access control.
# Keep HOST loopback. This value does not authenticate remote users.
TRUSTED_PUBLIC_ORIGIN=
# Optional additional exact origins, comma-separated; requires the primary origin above.
# Example: http://laneanew.cn,http://www.laneanew.cn
TRUSTED_PUBLIC_ORIGINS=
# Optional authenticated deployment; generated by scripts/provision-server-admin.ps1.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_SECONDS=28800
# Explicitly publish inspected reads and temporary calculations; all persistent writes still require admin.
PUBLIC_READ_ONLY=false
# Campus shared workspace: no named administrator login; all campus users can use business functions.
# This takes precedence over ADMIN_PASSWORD_HASH and PUBLIC_READ_ONLY. Keep origin/CSRF checks.
COLLABORATIVE_WORKSPACE=false
DATA_DIR=data/local
# Empty: embedded PostgreSQL (PGlite). External PostgreSQL uses the same migration.
DATABASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Current official alias: DeepSeek-V4.1-Flash-1017 (catalog checked 2026-10-17).
# Keep the API alias here. Actual response model is logged separately.
DEEPSEEK_SEARCH_API_KEY=
# Empty search key reuses DEEPSEEK_API_KEY. No keys belong in VITE_* variables.
# Independent official Search API with body reuse; deepseek_tools uses a separate Fetch call.
RESEARCH_WEB_PROVIDER=deepseek_content
# Qwen System One is the structured decision capability; DSH still organizes text research.
QWEN_DECISION_ENABLED=false
QWEN_DECISION_API_KEY=
QWEN_DECISION_MODEL=decision-model-preview
QWEN_DECISION_TIMEOUT_MS=12000
# Preview-specific gateway from the current official System One example.
QWEN_DECISION_ENDPOINT=https://trial.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
NODE_USE_ENV_PROXY=1
# Permit explicitly selected internal documents in model analysis. Each research round also requires consent.
ALLOW_INTERNAL_MODEL=false
# AMap Web (JS API) credentials; separate from the DeepSeek API key.
# Can also be saved through the local map settings dialog.
AMAP_JS_KEY=
AMAP_SECURITY_CODE=

# AIHOT-derived local intelligence: reads never invoke models.
INTELLIGENCE_COLLECTION_ENABLED=false
INTELLIGENCE_MODEL_ENABLED=false
INTELLIGENCE_DAILY_MODEL_CALLS=40
INTELLIGENCE_SELECTION_THRESHOLD=65
# Optional distinct DSH-compatible model for ambiguous event merge review.
INTELLIGENCE_REVIEW_MODEL=
