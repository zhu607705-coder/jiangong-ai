# Local development only. Keep secrets on the server.
HOST=127.0.0.1
PORT=4310
CAPABILITY_PORT=4311
WORKSPACE_PORT=5173
DATA_DIR=data/local
# Empty: embedded PostgreSQL (PGlite). External PostgreSQL uses the same migration.
DATABASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_SEARCH_API_KEY=
# Qwen System One is the structured decision capability; DSH still organizes text research.
QWEN_DECISION_ENABLED=false
QWEN_DECISION_API_KEY=
QWEN_DECISION_MODEL=decision-model-preview
QWEN_DECISION_TIMEOUT_MS=12000
# Preview-specific gateway from the current official System One example.
QWEN_DECISION_ENDPOINT=https://trial.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
NODE_USE_ENV_PROXY=1
# Internal material never leaves the local machine by default.
ALLOW_INTERNAL_MODEL=false
# AMap Web (JS API) credentials; separate from the DeepSeek API key.
# Can also be saved through the local map settings dialog.
AMAP_JS_KEY=
AMAP_SECURITY_CODE=

# AIHOT-derived local intelligence: reads never invoke models.
INTELLIGENCE_COLLECTION_ENABLED=false
INTELLIGENCE_MODEL_ENABLED=false
INTELLIGENCE_DAILY_MODEL_CALLS=40
INTELLIGENCE_SELECTION_THRESHOLD=65
# Optional distinct DSH-compatible model for ambiguous event merge review.
INTELLIGENCE_REVIEW_MODEL=
